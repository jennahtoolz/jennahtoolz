{
  "name": "qmee-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "start": "node --use-env-proxy --env-file-if-exists=.env server.mjs",
    "dev": "node --use-env-proxy --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:cloudflare": "node --test test/cloudflare.test.mjs",
    "dev:cloudflare": "wrangler dev --local",
    "build:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare-build",
    "deploy:cloudflare": "wrangler deploy",
    "check": "node --check server.mjs && node --check domain.mjs && node --check cloudflare/worker.mjs && node --check public/app.js && node --check public/metrics.mjs"
  },
  "dependencies": {
    "openai": "7.45.1"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "wrangler": "4.154.0"
  }
}
